POSTGRES_USER=cobroverificado
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=cobroverificado

COBROVERIFICADO_DATABASE_URL=postgresql://cobroverificado:cambia-esta-clave@postgres:5432/cobroverificado
COBROVERIFICADO_ANTHROPIC_API_KEY=
COBROVERIFICADO_MODELO_VISION=
COBROVERIFICADO_UMBRAL_CONFIANZA_OCR=0.85
COBROVERIFICADO_DIRECTORIO_IMAGENES=/var/lib/cobroverificado/imagenes
COBROVERIFICADO_RETENCION_HORAS=24
COBROVERIFICADO_LOG_LEVEL=INFO
# 32 bytes en hexadecimal: python -c "import secrets; print(secrets.token_hex(32))"
COBROVERIFICADO_CLAVE_CIFRADO=
